---
import Layout from '../layouts/Layout.astro';
import PageContainer from '../components/PageContainer.astro';
---

<Layout>
  <PageContainer>
    <div class="home-page">
      <div class="home-page-title">
      <h2>Home</h2>
      </div>
    </div>
  </PageContainer>
</Layout>

<style>
  .home-page {
    padding: 0 2rem 0 2rem;
  }
  .home-page-title {
    display: flex;
    justify-content: center;
    background-color: #f67fdc;
    border-radius: 12px;
    /* margin: 12px; */
    margin-top: 30px;
    margin-left: 9rem;
    margin-right: 9rem;
    padding: 8px 62px;
  }

  .home-page-title h2 {
    font-size: 26px;
    margin: 0;
    color: #ffffff;
  }
</style>
