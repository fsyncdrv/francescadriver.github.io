---
import Layout from '../layouts/Layout.astro';
import PageContainer from '../components/PageContainer.astro';
---

<Layout>
  <PageContainer>
    <div class="about">
    <!-- <div class="about-heading">
      <h2>About me</h2>
    </div> -->

    <div class="about-main">
      <div class="about-content">
        <p>Hi there! I'm Francesca.</p>
        <p>
          Welcome to my little corner of the internet! I'm currently working
          towards pursuing a PhD on the impact of AI on local and global
          communities. I want to explore it through a philosophical lens,
          in particular through ethics, aesthetics and philosophy of mind theories.
        </p>
        <p>
          Before that, I worked as a fullstack developer, building web
          applications with Clojure, ClojureScript and TypeScript.
        </p>
        <p>And in my spare time, I enjoy writing, playing video games and running.</p>
        <p>You can contact me on the following:</p>
        <div class="socials-div">
          <ul>
            <li>
              <a href="https://github.com/fsyncdrv">
                <img src="/github.png" alt="Github" class="socials-github">
                <span>Github</span>
              </a>
            </li>
            <li>
              <a href="https://www.linkedin.com/in/francesca-driver">
                <img src="/linkedin.png" alt="LinkedIn" class="socials-linkedin">
                <span>LinkedIn</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
      <div class="profile-pic-div">
        <img src="/me-2.png" alt="Francesca Driver">
      </div>

    </div>

    </div>
  </PageContainer>
</Layout>

<style>
  .about {
    /* display: flex;
    flex-direction: column;
    align-items: center; */
    /* text-align: center; */
    background-color: rgb(255, 255, 255);
    /* height: 100%; */
    /* box-sizing: border-box; */
    border-radius: 0 14px 14px 0;
    /* padding: 0 2rem 0 2rem; */
  }

  .about-main {
    display: flex;
    /* align-items: center; */
    gap: 1rem;
  }

  .profile-pic-div {
    width: 350px;
    height: 350px;
    background: url(/pp-paint-1.jpg);
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    position: relative;
    margin: 30px 0 50px;
    /* margin-bottom: 12px; */
  }

  .profile-pic-div img {
    width: 300px;
    position: absolute;
    margin-top: 8px;
    left: 45%;
    top: 55%;
    transform: translate(-50%, -50%);
  }

  .about-heading {
    display: flex;
    /* justify-content: center; */
    background-color: rgb(207, 233, 162);
    /* border-radius: 12px; */
    /* margin: 12px; */
    margin-top: 30px;
    /* margin-left: 9rem;
    margin-right: 9rem; */
    padding: 8px 62px;
  }

   .about-heading h2 {
    font-size: 26px;
    margin: 0;
    /* color: #242424; */
    color: #ffffff;
  }

  .about-content {
    font-family: 'Nunito', sans-serif;
    background-color: #cfdcf6;
    font-weight: 300;
    border-radius: 12px;
    padding: 2px 16px;
    /* margin-bottom: 12px; */
    margin: 12px 24px;
    margin-top: 30px;
    margin-bottom: 50px;
    text-align: left;
    flex: 1;
  }

  .about-content p {
    font-size: 16px;
    margin-top: 1.5rem;
    color: #3a1c3f;
    font-weight: 500;
    /* color: #242424; */
    /* margin-left: 1rem;
    margin-right: 1rem; */
  }

  .about-content ul {
    list-style: none;
    display: flex;
    align-items: left;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0;
    margin-top: 0;
  }

  .about-content ul li {
    width: 110px;
  }

  .about-content ul li a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    font-size: 16px;
    color: #3a1c3f;
    font-weight: bold;
  }

 .about-content ul li a:hover span {
    color: #b8336a;
  }

  .socials-div img {
    width: 30px;
    height: 30px;
  }

  .socials-div {
    margin-top: 24px;
  }

@media (max-width: 768px) {
  .about {
    border-radius: 14px;
  }

  .about-main {
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .about-content {
    flex: none;
    width: auto;
    margin: 20px 18px 0;
  }

  .about-content p {
    font-size: 15px;
  }

  .profile-pic-div {
    margin: 24px 0 30px;
  }
}
</style>
