---
import NavLeft from "./NavLeft.astro";
import Banner from "./Banner.astro";
---

<div class="container">
  <!-- <div class="nav-left">
    <NavLeft />
  </div> -->

  <div class="banner">
    <Banner />
  </div>

  <div class="content">
    <slot />
  </div>
</div>

<style>
  .container {
    height: 100%;
    /* background: white; */
    display: grid;
    /* TODO: uncomment the following when adding nav-left back */
    /* grid-template-columns: 220px 1fr;
    grid-template-rows: auto 1fr; */
    /* grid-template-areas:
      "nav banner"
      "nav content"; */
    /* TODO: remove the following 3 lines when adding nav-left back */
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr;
    grid-template-areas:
      "banner"
      "content";
    border-radius: 14px;
    overflow: hidden;
    /* TODO: remove the following 2 lines when adding nav-left back */
    margin-right: 60px;
    margin-left: 60px;
  }

  .nav-left {
    grid-area: nav;
    position: sticky;
    top: 0;
    /* display: flex; */
  }

  .banner {
    grid-area: banner;
  }

  .content {
    grid-area: content;
    background-color: #fff;
    border-radius: 0 0 0 14px;
  }

  .content {
    grid-area: content;
    min-width: 0;
    min-height: 0;
    overflow-y: auto;
  }

  @media (max-width: 768px) {
    .container {
      height: 100%;
      grid-template-columns: 1fr;
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        "banner"
        "nav"
        "content";
    }

    .content {
      overflow-y: auto;
      /* display: contents; */
    }
  }
</style>
