---
import NavLeft from "./NavLeft.astro";
import Banner from "./Banner.astro";
---

<div class="container">
  <div class="nav-left">
    <NavLeft />
  </div>

  <div class="banner">
    <Banner />
  </div>

  <div class="content">
    <slot />
  </div>
</div>

<style>
  .container {
    background: white;
    display: grid;
    grid-template-columns: 1fr 4fr;
    grid-template-areas:
      "nav banner"
      "nav content";
    border-radius: 0 0 14px 14px;
  }

  .nav-left {
    grid-area: nav;
    /* display: flex; */
  }

  .banner {
    grid-area: banner;
  }

  .content {
    grid-area: content;
  }

  .content {
    grid-area: content;
    min-width: 0;
  }

  @media (max-width: 768px) {
    .container {
      grid-template-columns: 1fr;
      grid-template-areas:
        "banner"
        "nav"
        "content";
    }

    .content {
      display: contents;
    }
  }
</style>
