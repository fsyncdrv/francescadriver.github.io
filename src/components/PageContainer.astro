---
import NavLeft from "./NavLeft.astro";
---

<div class="container">
  <div class="nav-left">
    <NavLeft />
  </div>

  <div class="posts">
    <slot />
  </div>
</div>

<style>
  .container {
    background: white;
    display: grid;
    grid-template-columns: 1fr 3fr;
    grid-template-areas:
      "nav posts";
    border-radius: 12px;
  }

  .nav-left {
    grid-area: nav;
    /* display: flex; */
  }

  .posts {
    grid-area: posts;
  }

  @media (max-width: 768px) {
    .container {
      grid-template-columns: 1fr;
      grid-template-areas:
        "posts"
        "nav";
    }
  }
</style>
