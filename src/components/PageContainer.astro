---
import NavLeft from "./NavLeft.astro";
---

<div class="container">
  <div class="nav-left">
    <NavLeft />
  </div>

  <div class="content">
    <slot />
  </div>
</div>

<style>
  .container {
    background: white;
    display: grid;
    grid-template-columns: 1fr 4fr;
    grid-template-areas:
      "nav content";
    border-radius: 0 0 14px 14px;
  }

  .nav-left {
    grid-area: nav;
    /* display: flex; */
  }

  .content {
    grid-area: content;
  }

  @media (max-width: 768px) {
    .container {
      grid-template-columns: 1fr;
      grid-template-areas:
        "content"
        "nav";
    }
  }
</style>
