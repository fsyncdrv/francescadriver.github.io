---
import NavLeft from "./NavLeft.astro";
import Banner from "./Banner.astro";
---

<div class="container">
  <div class="nav-left">
    <NavLeft />
  </div>

  <div class="banner">
    <Banner />
  </div>

  <div class="content">
    <slot />
  </div>
</div>

<style>
  .container {
    height: 100%;
    background: white;
    display: grid;
    grid-template-columns: 1fr 4fr;
    grid-template-rows: auto 1fr;
    grid-template-areas:
      "nav banner"
      "nav content";
    border-radius: 14px 14px 14px 14px;
    overflow: hidden;
  }

  .nav-left {
    grid-area: nav;
    position: sticky;
    top: 0;
    /* display: flex; */
  }

  .banner {
    grid-area: banner;
  }

  .content {
    grid-area: content;
  }

  .content {
    grid-area: content;
    min-width: 0;
    min-height: 0;
    overflow-y: auto;
  }

  @media (max-width: 768px) {
    .container {
      height: 100%;
      grid-template-columns: 1fr;
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        "banner"
        "nav"
        "content";
    }

    .content {
      overflow-y: auto;
      /* display: contents; */
    }
  }
</style>
