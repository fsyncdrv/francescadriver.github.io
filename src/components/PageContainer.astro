---
import NavLeft from "./NavLeft.astro";
import About from "./About.astro";
---

<div class="container">
  <div class="nav-left">
    <NavLeft />
  </div>

  <div class="posts">
    <slot />
  </div>

  <div class="about">
    <About />
  </div>
</div>

<style>
  .container {
    background: white;
    display: grid;
    grid-template-columns: 1fr 3fr 1fr;
    grid-template-areas:
      "nav posts about";
    gap: 2rem;
  }

  .nav-left {
    grid-area: nav;
  }

  .posts {
    grid-area: posts;
  }

  .about {
    grid-area: about;
  }

  @media (max-width: 768px) {
    .container {
      grid-template-columns: 1fr;
      grid-template-areas:
        "posts"
        "nav"
        "about";
    }
  }
</style>
